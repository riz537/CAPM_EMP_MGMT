<mvc:View controllerName="com.demo.empmgmtui.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"  xmlns:mdc="sap.ui.mdc"
    xmlns:mdctable="sap.ui.mdc.table">
    <Page id="page" title="{i18n>title}">
      <content>
        <Table id="oTableEmp" items="{/Employees}" mode="SingleSelectLeft" >
        <headerToolbar>
          <Toolbar >
            <Button text="Promote Employee" type="Emphasized" press="onPromoteEmployee"></Button>
            <Button text="Make PERMANENT" type="Emphasized" press="onMakePermanent"></Button>
            <Button text="onGetAnnualBonus" type="Emphasized" press="onGetAnnualBonus"></Button>
            <Button text="onGiveHike" type="Emphasized" press="onGiveHike"></Button>
            <Button text="onGetTopRatedEmployees" type="Emphasized" press="onGetTopRatedEmployees"></Button>
          </Toolbar>
        </headerToolbar>
         <columns>
           <Column >
            <Text text="Employee Id"></Text>
           </Column>
            <Column >
            <Text text="Name"></Text>
           </Column>
            <Column >
            <Text text="Designation"></Text>
           </Column>
            <Column >
            <Text text="Salary"></Text>
           </Column>
            <Column >
            <Text text="Status"></Text>
           </Column>
         </columns>
         <items>
           <ColumnListItem >
             <Text text="{ID}"></Text>
             <Text text="{name}"></Text>
             <Text text="{designation}"></Text>
              <Text text="{salary}"></Text>
                <Text text="{status}"></Text>
           </ColumnListItem>
         </items>
        
        </Table>
       

            <mdc:Table
                
                header="Employee Management"
                p13nMode="Column,Sort,Filter"
                type="ResponsiveTable"
                selectionMode="Single"
                delegate='{
                    "name": "sap/ui/mdc/odata/v4/TableDelegate",
                    "payload": {}
                }'>

                <mdc:columns>
                    <mdctable:Column
                        header="Employee ID"
                        propertyKey="ID">
                        <mdctable:template>
                            <Text text="{ID}" />
                        </mdctable:template>
                    </mdctable:Column>

                    <mdctable:Column
                        header="Name"
                        propertyKey="name">
                        <mdctable:template>
                            <Text text="{name}" />
                        </mdctable:template>
                    </mdctable:Column>

                    <mdctable:Column
                        header="Designation"
                        propertyKey="designation">
                        <mdctable:template>
                            <Text text="{designation}" />
                        </mdctable:template>
                    </mdctable:Column>

                    <mdctable:Column
                        header="Salary"
                        propertyKey="salary">
                        <mdctable:template>
                            <Text text="{salary}" />
                        </mdctable:template>
                    </mdctable:Column>

                    <mdctable:Column
                        header="Status"
                        propertyKey="status">
                        <mdctable:template>
                            <Text text="{status}" />
                        </mdctable:template>
                    </mdctable:Column>
                </mdc:columns>

                

            </mdc:Table>
       

      </content>
    </Page>
</mvc:View>